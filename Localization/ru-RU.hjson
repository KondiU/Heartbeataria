        Tiles.TVTile.MapEntry: Телевизор

        Dialogue: {
            StarMerchant: {
                StarMerchantDialogue1: Ты даже не представляешь, за сколько за границей продают блоки грязи.
                StarMerchantDialogue2: Лучшая сделка в моей жизни — это когда я обменял уголь на алмазный меч!
                StarMerchantDialogue3: Нихао! Хочешь поторговать?
                StarMerchantDialogue4: Хватай свои изумруды, и погнали! Ой, прости — забыл, что вы тут все используете монеты...
                StarMerchantDialogue5: Микротранзакции? Никогда о таком не слышал!
                StarMerchantDialogue6: Обожаешь лягушек? Испытай удачу в моей лотерее листьев!
                StarMerchantDialogue7: Поверь мне, криптонит не сделает тебя сильнее — я проверял.
                StarMerchantDialogue8: Привет! Не хочешь прикупить кое-чего?
                StarMerchantDialogue9: Хм, это место сильно изменилось с моего последнего визита... прямо как мой ассортимент! Взгляни!
                StarMerchantDialogue10: Мне здесь нравится, хотя я всё же надеюсь когда-нибудь вернуться на родную планету... В любом случае, купишь что-нибудь?
                StarMerchantDialogue11: Всегда найдётся время для хунбао... И для торговли, конечно же!
                StarMerchantNoShimmerDialogue1: Эй, ты не видел мою синюю броню? Кажется, я где-то её потерял...
                StarMerchantShimmerDialogue1: Мой самый удобный костюм! Так рад, что вернул его!
                StarMerchantDay1: Ах, небо сегодня просто прекрасное!
                StarMerchantNight1: Спорим, эти ребята сгорают в мгновение ока!
                StarMerchantNight2: Если каждая ночь здесь выглядит так, мне точно пора завести рельсотрон!
                StarMerchantNight3: Полюбуемся звёздами сегодня?
                StarMerchantRain1: Ха, по крайней мере, моя роба водонепроницаемая!
                StarMerchantRain2: Этот дождь — просто морось по сравнению с ливнями на Нептуне!
                StarMerchantRain3: Мир дождя — это матрица!
                StarMerchantWind1: Обожаю холодный ветер, он подсказывает мне путь!
                StarMerchantHat1: Эта шляпа кажется до странности знакомой...
                StarMerchantBloodMoon1: К чему паника? По крайней мере, здешние скелеты не ездят верхом на пауках... Или ездят?
                StarMerchantMechanicDialogue1: Интересно, нет ли у {0} на продажу немного редстоуна.
                StarMerchantGuideDialogue1: Надо заглянуть к {0}, он кажется очень знающим парнем — может, он поможет мне вернуться домой?
                StarMerchantTravellingMerchantDialogue1: А? {0} тоже здесь? Наконец-то! Достойный противник!
                StarMerchantZoologistDialogue1: Никогда не спрашивай женщину о её возрасте, мужчину о зарплате, а {0} о том, как сделаны некоторые товары из моего набора KFC...
                StarMerchantMerchantDialogue1: Оказывается, некоторым здешним ребятам очень нравится мой стиль — только посмотри на гардероб {0}!
                StarMerchantClothierDialogue1: Похоже, {0} много знает об одежде, но спорю, он никогда не видел вещей, что есть у меня на продажу!
                StarMerchantTruffleDialogue1: О, {0}! Они понимают меня как никто другой... Похоже, у нас много общего!
            }
        }

        Emotes.StarMerchantEmote.Command: starmerchant
    }
}